# Godot 4.7.1 test_setup() creates ProjectSettings without loading a project.
# project_data_dir_name is therefore empty. String::append_utf32_unchecked()
# reaches memcpy(dst, nullptr, 0), which GCC UBSAN reports as nonnull-attribute.
# Suppress only this check in this engine source file.
nonnull-attribute:core/string/ustring.cpp

# Godot 4.7.1 bundles an SDL TLS trailing-array idiom that GCC UBSAN reports as
# bounds during SDL/HIDAPI startup. The same diagnostic occurs in an exact-build
# editor without TickSynchronizer and is fixed in newer upstream SDL sources.
bounds:thirdparty/sdl/thread/SDL_thread.c

# Godot 4.7.1 stores a validated GDScript operator pointer through a 32-bit
# bytecode slot. GCC UBSAN reports the potentially 4-byte-aligned pointer store.
# A pure GDScript project reproduces the diagnostic without TickSynchronizer.
alignment:modules/gdscript/gdscript_vm.cpp

# These category-and-source pairs are the complete accepted set. Every other
# UBSAN source location, including every TickSynchronizer source file, remains
# fatal. scripts/verify_sanitizer_suppressions.sh enforces this exact policy.
